{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lithosky scenes v1 and v2",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "version",
        "title",
        "terrain",
        "camera",
        "water",
        "lighting"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "lithosky"
          ]
        },
        "version": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "terrain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generator",
            "seed",
            "elevation",
            "palette"
          ],
          "properties": {
            "generator": {
              "type": "string",
              "enum": [
                "terrain-v1"
              ]
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "elevation": {
              "type": "number",
              "minimum": 0.4,
              "maximum": 1.7
            },
            "palette": {
              "type": "string",
              "enum": [
                "natural",
                "otherworld"
              ]
            }
          }
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "yaw",
            "pitch",
            "distance"
          ],
          "properties": {
            "yaw": {
              "type": "number",
              "minimum": -3.141592653589793,
              "maximum": 3.141592653589793
            },
            "pitch": {
              "type": "number",
              "minimum": 0.08,
              "maximum": 1.2
            },
            "distance": {
              "type": "number",
              "minimum": 10,
              "maximum": 48
            }
          }
        },
        "water": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "level"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "level": {
              "type": "number",
              "minimum": -3,
              "maximum": 5
            }
          }
        },
        "lighting": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sunElevation"
          ],
          "properties": {
            "sunElevation": {
              "type": "number",
              "minimum": 5,
              "maximum": 85
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "version",
        "title",
        "terrain",
        "camera",
        "water",
        "lighting"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "lithosky"
          ]
        },
        "version": {
          "type": "integer",
          "enum": [
            2
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "terrain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generator",
            "seed",
            "elevation",
            "palette",
            "resolution",
            "layers"
          ],
          "properties": {
            "generator": {
              "type": "string",
              "enum": [
                "layers-v1"
              ]
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "elevation": {
              "type": "number",
              "minimum": 0.4,
              "maximum": 1.7
            },
            "palette": {
              "type": "string",
              "enum": [
                "natural",
                "otherworld"
              ]
            },
            "resolution": {
              "type": "integer",
              "enum": [
                256,
                512,
                1024,
                2048
              ]
            },
            "layers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "enabled",
                  "strength",
                  "scale",
                  "octaves"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "fbm",
                      "ridge",
                      "warp",
                      "terrace"
                    ]
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "strength": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "scale": {
                    "type": "number",
                    "minimum": 0.25,
                    "maximum": 8
                  },
                  "octaves": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8
                  }
                }
              }
            }
          }
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "yaw",
            "pitch",
            "distance"
          ],
          "properties": {
            "yaw": {
              "type": "number",
              "minimum": -3.141592653589793,
              "maximum": 3.141592653589793
            },
            "pitch": {
              "type": "number",
              "minimum": 0.08,
              "maximum": 1.2
            },
            "distance": {
              "type": "number",
              "minimum": 10,
              "maximum": 48
            }
          }
        },
        "water": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "level"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "level": {
              "type": "number",
              "minimum": -3,
              "maximum": 5
            }
          }
        },
        "lighting": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sunElevation"
          ],
          "properties": {
            "sunElevation": {
              "type": "number",
              "minimum": 5,
              "maximum": 85
            }
          }
        }
      }
    }
  ]
}
